<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\Windows\icon.ico</ApplicationIcon>
        <Version>3.0.0</Version>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DebugType>none</DebugType>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)'=='Debug'"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="Magick.NET-Q16-arm64" Version="15.0.0" Condition="'$(RuntimeIdentifier)'=='osx-arm64'"/>
        <PackageReference Include="Magick.NET-Q16-x64" Version="15.1.0" Condition="'$(RuntimeIdentifier)'!='osx-arm64'"/>
        <PackageReference Include="Semi.Avalonia" Version="12.1.0.1"/>
    </ItemGroup>
</Project>
